# Dedicated Supabase project for moataz-ai-telegram-hub.
# Never reuse another project's Supabase URL, database, storage, or secrets.
NEXT_PUBLIC_SUPABASE_URL=https://ywtfvgkhrmouqxsocgdq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=https://moatazalalqami.online

# Server-only Supabase secret. Configure only in Railway or another trusted backend.
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Database migrations executed before Railway starts the web server.
# Prefer the pooled connection string copied from Supabase Connect.
DATABASE_URL=
# Alternative fallback: provide the database password and the startup script derives
# the direct PostgreSQL URL from NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_DB_PASSWORD=
RUN_DATABASE_MIGRATIONS=true
PGCONNECT_TIMEOUT=20

# One-time secure owner bootstrap. Keep the password only in Railway Variables.
# Remove OWNER_BOOTSTRAP_PASSWORD after the deployment logs confirm success.
OWNER_BOOTSTRAP_EMAIL=mtzallqmy@gmail.com
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_USERNAME=mtzallqmy
OWNER_BOOTSTRAP_DISPLAY_NAME=معتز العلقمي
OWNER_BOOTSTRAP_FORCE_RESET=false

# Server-only encryption and ownership configuration.
PROVIDER_ENCRYPTION_KEY=
PLATFORM_OWNER_EMAILS=mtzallqmy@gmail.com
ALLOW_PRIVATE_PROVIDER_URLS=false
MAX_UPLOAD_BYTES=104857600

# Temporary email/password access while Google/GitHub OAuth is repaired.
TEMPORARY_OWNER_PASSWORD_LOGIN_ENABLED=true
PASSWORD_AUTH_ENABLED=true
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED=true
ALLOWED_ORIGINS=https://moatazalalqami.online,https://www.moatazalalqami.online

# Central Telegram bot. One bot serves all site users.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE_SECRET=

# Runtime capabilities. Chat stays disabled until a real provider, credential, and model exist.
AI_CHAT_ENABLED=false
FILE_UPLOADS_ENABLED=true
CONTENT_EDITOR_ENABLED=true
TELEGRAM_INTEGRATION_ENABLED=true
SCHEDULED_PUBLISHING_ENABLED=false
